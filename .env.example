# Copy to .env and fill in. .env is git-ignored. Never paste keys in chat or commit them.

# SharePoint Online (read-only, via Microsoft Graph, delegated sign-in)
SPO_TENANT=ammegagroup.onmicrosoft.com
SPO_CLIENT_ID=9cb5d570-0bbc-45ec-bc80-f944d2952c7d
SPO_SITE_HOST=ammegagroup.sharepoint.com
SPO_SITE_PATH=/sites/Datasheets
SPO_LIBRARY=PDF

# DAM (AMMshare) - used from step 2 onwards
DAM_API_BASE=https://dam.ammega.com/api
DAM_API_KEY=
DAM_USER_EMAIL=
# Container that holds the datasheets (id, not name). Leave blank to let s2_dam_probe.py help find it.
DAM_CONTAINER_ID=
# Only needed if the API key has allowed domains configured
DAM_SITE_DOMAIN=
